# Chế độ giao dịch: PAPER (Mô phỏng giá thật Binance), TESTNET (Binance Demo), MAINNET (Tiền thật)
TRADING_MODE=PAPER

# API Key cho Binance Futures Mainnet (https://www.binance.com)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# API Key cho Binance Futures Testnet (https://testnet.binancefuture.com)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Cấu hình mặc định của Bot
DEFAULT_LEVERAGE=20
DEFAULT_MARGIN_TYPE=ISOLATED
PAPER_INITIAL_BALANCE=10000.0
USE_ACCOUNT_BALANCE_FOR_RISK=false
PORT=8000

